name: Weekly site review

on:
  schedule:
    - cron: "0 6 * * 0"   # every Sunday, 06:00 UTC
  workflow_dispatch:       # lets you run it manually from the Actions tab

permissions:
  contents: write
  pull-requests: write

jobs:
  review:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - run: pip install anthropic

      - run: python agent.py
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}

      - uses: peter-evans/create-pull-request@v6
        with:
          title: "Weekly site review"
          body: "تقرير أسبوعي من الـ agent. راجعه قبل أي تعديل على الموقع."
          branch: agent/weekly-review
          commit-message: "Add weekly site review report"
          add-paths: agent-reports/
